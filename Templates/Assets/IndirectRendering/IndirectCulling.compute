#pragma kernel CSMain

// Layout must match InstanceData.cs byte-for-byte.
struct InstanceData
{
    float3 position;
    float scale;
    float4 rotation;
};

StructuredBuffer<InstanceData> _AllInstances;
AppendStructuredBuffer<InstanceData> _VisibleInstances;

uint _InstanceCount;
float3 _CullOrigin;
float _CullRadius;
float _LodMinDistance; // 0, если LOD не используется - см. Docs/06-lod.html
float _MeshBoundsRadius;
float3 _MeshBoundsCenter; // центр bounds меша относительно корня (у дерева - середина кроны, не земля)
float3 _MeshBoundsExtents;
float4x4 _ViewProjection; // GL.GetGPUProjectionMatrix(camera.projectionMatrix) * camera.worldToCameraMatrix
float4 _FrustumPlanes[6]; // GeometryUtility.CalculateFrustumPlanes: xyz - нормаль внутрь, w - distance
float3 _ShadowSweep;      // теневой проход: направление света * дальность теней (тень дерева вне кадра может упасть в кадр), иначе 0
int _EnableDistance;
int _EnableFrustum;

// Диагностический выход для _DebugInstanceIndex - см. Docs/04-diagnostics.html.
RWStructuredBuffer<float4> _DebugClipPos;
uint _DebugInstanceIndex;

// Сфера против 6 плоскостей камеры. Clip-space вариант (|x| <= w + r) занижал радиус в ~1/tan(fov/2) раз
// и отрезал большие деревья, частично попадающие в кадр у края
bool IsInsideFrustum(float3 worldPos, float radius)
{
    bool inside = true;
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        // Сфера, протянутая вдоль света (капсула): внутри плоскости, если внутри хотя бы один её конец
        float d0 = dot(_FrustumPlanes[i].xyz, worldPos) + _FrustumPlanes[i].w;
        float d1 = dot(_FrustumPlanes[i].xyz, worldPos + _ShadowSweep) + _FrustumPlanes[i].w;
        inside = inside && max(d0, d1) >= -radius;
    }
    return inside;
}

float3 RotateByQuaternion(float3 v, float4 q)
{
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}

float3 BoundsCenterWS(InstanceData inst)
{
    return inst.position + RotateByQuaternion(_MeshBoundsCenter * inst.scale, inst.rotation);
}

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _InstanceCount) return;

    InstanceData inst = _AllInstances[index];

    if (index == _DebugInstanceIndex)
    {
        float4 clipPosDbg = mul(_ViewProjection, float4(BoundsCenterWS(inst), 1.0));
        _DebugClipPos[0] = float4(clipPosDbg.xyz, clipPosDbg.w + _MeshBoundsRadius * inst.scale);
    }

    if (_EnableDistance != 0)
    {
        float dist = distance(inst.position, _CullOrigin);
        if (dist > _CullRadius || dist < _LodMinDistance) return;
    }

    if (_EnableFrustum != 0)
    {
        float radius = _MeshBoundsRadius * inst.scale;
        if (!IsInsideFrustum(BoundsCenterWS(inst), radius)) return;
    }

    _VisibleInstances.Append(inst);
}

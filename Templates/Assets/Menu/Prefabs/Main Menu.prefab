  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "* \u041B\u044E\u0446\u0438\u044F \u041B\u0443\u043D\u0430\u0434\u043E\u0442\u0442\u0438\u0440 \u2013 \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442, \u0430\u0440\u0442 \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440, \u043A\u0440\u0435\u0430\u0442\u0438\u0432\u043D\u044B\u0439 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440, \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0441\u0442, \u0433\u0435\u0439\u043C-\u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440, \u043B\u0435\u0432\u0435\u043B-\u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440, \u0430\u043D\u0438\u043C\u0430\u0442\u043E\u0440.\r\n* \u0410\u043D\u0430\u043D\u0434\u0430 \u042D\u043E\u0441 \u2013 \u0421\u0446\u0435\u043D\u0430\u0440\u0438\u0441\u0442 \u0438 \u0431\u043E\u043B\u0435\u0435 \u043A\u0440\u0435\u0430\u0442\u0438\u0432\u043D\u044B\u0439 \u0447\u0435\u043C \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440.\r\n* \u041B\u044E\u0446\u0438\u044F \u041B\u0443\u043D\u0430\u0434\u043E\u0442\u0442\u0438\u0440 \u2013 \u041C\u0443\u0437\u044B\u043A\u0430.\r\n* \u041B\u044E\u0446\u0438\u044F \u041B\u0443\u043D\u0430\u0434\u043E\u0442\u0442\u0438\u0440 \u2013  3\u0434 \u043C\u043E\u0434\u0435\u043B\u0435\u0440.\r\n* Filter Dust - 3\u0434 \u043C\u043E\u0434\u0435\u043B\u0435\u0440.\n* Sato - \u0430\u0432\u0442\u043E\u0440 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0439 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439 \u041B\u0438\u044D\u0440\u0438\u0441.\n* Lain - \u0413\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440.\n\n\n\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u043D\u0430\u0442\u0435\u0440\u0430\u043C:\n* Lexx32\n* Arc Amp\n* Kostr184\n* \u0410\u043D\u044F \u0412\u043E\u0439\u043D\u043E\u0432\u0430 "
  m_isRightToLeft: 0

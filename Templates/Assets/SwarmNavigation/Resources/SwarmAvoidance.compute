// Разведение агентов на GPU: uniform grid в хэш-таблице со связными списками (без сортировки), затем один проход на агента.
// Вход: позиции и флаги (SwarmNav пакует их раз в кадр). Выход Result[i] = (pushX, pushZ, давление, касаний прибывших своей группы).
// Дальше результат читается на CPU через AsyncGPUReadback (задержка 1-3 кадра) и подмешивается в направление шага.

#pragma kernel CSClear
#pragma kernel CSBuild
#pragma kernel CSSolve

#define EMPTY 0xFFFFFFFFu
#define FLAG_ACTIVE 1u
#define FLAG_ARRIVED 2u

RWStructuredBuffer<uint> Heads;          // TableMask + 1 голов списков
RWStructuredBuffer<uint> Next;           // следующий агент в списке ячейки
StructuredBuffer<float4> Agents;         // xyz - позиция, w - флаги (asuint): бит0 активен, бит1 прибыл, биты 2..7 - радиус (0.1 м), биты 8.. - группа цели
RWStructuredBuffer<float4> Result;

uint AgentCount;
uint TableMask;
float CellSize;          // не меньше самой большой суммы радиусов пары
float Radius;            // запасной радиус пары, если у агента радиус не задан
float ContactDistance;   // ближе - считается касанием прибывшего
uint MaxNeighbors;       // потолок обхода соседей на агента (защита от патологических скоплений)
float MaxHeightDelta;    // агенты на разных высотах (остров над землёй) друг друга не видят

float AgentRadius(float4 agent)
{
    return ((asuint(agent.w) >> 2) & 63u) * 0.1;
}

uint CellHash(int2 cell)
{
    return ((uint)cell.x * 73856093u ^ (uint)cell.y * 19349663u) & TableMask;
}

int2 CellOf(float3 position)
{
    return (int2)floor(position.xz / CellSize);
}

[numthreads(256, 1, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x <= TableMask) Heads[id.x] = EMPTY;
}

[numthreads(256, 1, 1)]
void CSBuild(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= AgentCount) return;

    float4 a = Agents[i];
    if ((asuint(a.w) & FLAG_ACTIVE) == 0) return;

    uint previous;
    InterlockedExchange(Heads[CellHash(CellOf(a.xyz))], i, previous);
    Next[i] = previous;
}

[numthreads(256, 1, 1)]
void CSSolve(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= AgentCount) return;

    float4 self = Agents[i];
    if ((asuint(self.w) & FLAG_ACTIVE) == 0)
    {
        Result[i] = 0;
        return;
    }

    uint group = asuint(self.w) >> 8;
    int2 cell = CellOf(self.xyz);
    float2 push = 0;
    float pressure = 0;
    float touches = 0;
    uint visited = 0;
    float selfRadius = AgentRadius(self);

    for (int dz = -1; dz <= 1; dz++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            uint j = Heads[CellHash(cell + int2(dx, dz))];
            while (j != EMPTY && visited < MaxNeighbors)
            {
                visited++;
                if (j != i)
                {
                    float4 other = Agents[j];
                    float2 offset = self.xz - other.xz;
                    float distanceSq = dot(offset, offset);
                    float pairRadius = selfRadius + AgentRadius(other);
                    if (pairRadius <= 0) pairRadius = Radius;
                    if (distanceSq < pairRadius * pairRadius && abs(self.y - other.y) < MaxHeightDelta)
                    {
                        float distance = sqrt(distanceSq);
                        // Совпавшие позиции (спавн в одной точке): направление из индексов пары, чтобы расходились.
                        float2 direction = distance > 1e-4 ? offset / distance : float2(cos((float)(i * 7 + j)), sin((float)(i * 7 + j)));
                        bool otherArrived = (asuint(other.w) & FLAG_ARRIVED) != 0;

                        // Прибывший не уступает - отталкивание от него сильнее.
                        // Плюс боковая составляющая (всегда в одну сторону): лоб в лоб агенты не замирают, а расходятся.
                        float weight = ((pairRadius - distance) / pairRadius) * (otherArrived ? 1.5 : 1.0);
                        push += direction * weight + float2(direction.y, -direction.x) * (weight * 0.4);
                        pressure += 1;
                        if (otherArrived && distance < ContactDistance && (asuint(other.w) >> 8) == group) touches += 1;
                    }
                }
                j = Next[j];
            }
        }
    }

    Result[i] = float4(push, pressure, touches);
}
